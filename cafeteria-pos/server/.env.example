# Base de datos: SQLite por defecto (archivo relativo a server/prisma/).
DATABASE_URL="file:./dev.db"

# Secreto para firmar los JWT. En producción es obligatorio y de 24+ caracteres.
JWT_SECRET="solo-para-desarrollo-cambiar-en-produccion"
JWT_EXPIRES_IN="12h"

PORT=4000

# Nombre que aparece en la boleta.
NOMBRE_LOCAL="Cafetería"

# Solo si el frontend se sirve desde OTRO origen (normalmente no hace falta).
# CORS_ORIGIN="http://localhost:5173"
