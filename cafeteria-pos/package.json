{
  "name": "cafeteria-pos",
  "version": "2.0.0",
  "private": true,
  "description": "POS integral para cafetería: stock FIFO, recetas y costeo, mostrador y mesas, boletas, comanda, pantalla cliente y dashboard.",
  "scripts": {
    "iniciar": "node scripts/iniciar.mjs",
    "setup": "node scripts/iniciar.mjs --preparar",
    "build": "node scripts/iniciar.mjs --preparar --reconstruir",
    "start": "npm start --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:web": "npm run dev --prefix web",
    "test": "npm test --prefix server"
  },
  "engines": {
    "node": ">=22"
  }
}
