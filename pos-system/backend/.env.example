# Base de datos: por defecto SQLite (no requiere infraestructura).
# Para usar PostgreSQL, cambia el provider en prisma/schema.prisma a "postgresql"
# y define aqui la URL de conexion (ver README.md, seccion "Migrar a PostgreSQL").
DATABASE_URL="file:./dev.db"

# Secreto para firmar los JWT. Cambialo en un ambiente real.
JWT_SECRET="cambia-este-secreto-en-produccion"

# Expiracion del token de sesion.
JWT_EXPIRES_IN="12h"

# Puerto del servidor backend.
PORT=4000

# Origen permitido para CORS (frontend).
CORS_ORIGIN="http://localhost:5173"
